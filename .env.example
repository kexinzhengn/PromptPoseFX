# OpenAI-compatible API endpoint. Leave empty to use the official OpenAI endpoint.
OPENAI_API_BASE=
OPENAI_API_KEY=replace-with-your-api-key

# Model identifiers supported by the configured endpoint.
OPENAI_MAIN_AGENT_MODEL=gpt-5-mini
OPENAI_CODE_AGENT_MODEL=gpt-5-nano

# Optional. Defaults to OPENAI_CODE_AGENT_MODEL when omitted.
OPENAI_REFERENCE_ANALYZER_MODEL=gpt-5-nano

# Saved-Effect evidence limits.
MAX_REFERENCE_EVIDENCE_CHARS=8000
REFERENCE_ANALYZER_CONCURRENCY=3

# Optional local server overrides.
SERVER_HOST=127.0.0.1
SERVER_PORT=5800
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200
